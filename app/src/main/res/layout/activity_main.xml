<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/myTheme"
    android:id="@+id/mainR"
    tools:context=".MainActivity"
    android:forceDarkAllowed="false"

    >

    <RelativeLayout
        android:id="@+id/tbx"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#fcbf04"
        android:orientation="horizontal"
        android:forceDarkAllowed="false">

        <ImageView
            android:onClick="back"
            android:paddingVertical="13dp"
            android:id="@+id/icn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_baseline_arrow_back_ios_24"
            android:contentDescription="TODO"
            android:forceDarkAllowed="false"/>

        <TextView
            android:textSize="20sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Color to Value"
            android:textColor="@color/white"
            android:forceDarkAllowed="false"/>

        <ImageView
            android:layout_marginEnd="8dp"
            android:id="@+id/more_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:tint="@color/white"
            android:forceDarkAllowed="false"/>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/crd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tbx"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        android:forceDarkAllowed="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:forceDarkAllowed="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="8dp"
                android:text="Number of Bands"
                android:textColor="@color/black"
                android:forceDarkAllowed="false"/>

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:orientation="horizontal"
                android:forceDarkAllowed="false">

                <RadioButton
                    android:id="@+id/radioButton1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#60281a"
                    android:text="4 Band"
                    android:textColor="#60281a"
                    android:forceDarkAllowed="false"/>

                <RadioButton
                    android:id="@+id/radioButton2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:buttonTint="#60281a"
                    android:text="5 Band"
                    android:textColor="#60281a"
                    android:forceDarkAllowed="false"/>

                <RadioButton
                    android:id="@+id/radioButton3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:buttonTint="#60281a"
                    android:text="6 Band"
                    android:textColor="#60281a"
                    android:forceDarkAllowed="false"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@id/crd"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:forceDarkAllowed="false">

        <include
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:id="@+id/b4_lay"
            layout="@layout/resistor_4b"
            android:forceDarkAllowed="false"/>
        <include
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:id="@+id/b5_lay"
            layout="@layout/resistor_5b"
            android:forceDarkAllowed="false"/>
        <include
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:id="@+id/b6_lay"
            layout="@layout/resistor_6b"
            android:forceDarkAllowed="false"/>
    </LinearLayout>

    <TextView
        android:fontFamily="sans-serif-black"
        android:id="@+id/vlu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:text="100k ohm"
        android:textAlignment="center"
        android:textColor="#302F2F"
        android:textSize="25dp"
        android:forceDarkAllowed="false"/>

    <LinearLayout
        android:layout_above="@id/cvAdsL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/vlu"
        android:forceDarkAllowed="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:forceDarkAllowed="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:forceDarkAllowed="false">

                <LinearLayout
                    android:id="@+id/fst_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1st Band"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/snd_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2nd Band"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/trd_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3rd Band"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mlt_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multiplier"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tlr_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tolerance"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/tmp_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:forceDarkAllowed="false">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperature Coefficient"
                        android:textColor="#302F2F"
                        android:forceDarkAllowed="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_boder"
                        android:orientation="horizontal"
                        android:forceDarkAllowed="false">

                        <Spinner
                            android:backgroundTint="@color/black"
                            android:id="@+id/spn5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:forceDarkAllowed="false"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
<!--    <com.google.android.gms.ads.AdView-->
<!--        xmlns:ads="http://schemas.android.com/apk/res-auto"-->
<!--        android:id="@+id/adView"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
